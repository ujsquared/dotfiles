# Whitelist: only the dirs below are tracked. Everything else in ~/.config is ignored.
/*
!/hypr/
!/alacritty/
!/nvim/
!/waybar/
!/rofi/
!/tmux/
!/zsh/
!/ghostty/
!/swappy/
!/normcap/

# alacritty: skip vendored theme repo (has its own .git) + stale backups
/alacritty/themes/
/alacritty/*.bak
/alacritty/*.yml.*

# rofi: runtime symlink to current wallpaper (machine state)
/rofi/.current_wallpaper

# normcap: OCR language data (4MB binary, redownloaded by normcap)
/normcap/tessdata/

# don't ignore these themselves (they match /*)
!.gitignore
!README.md
